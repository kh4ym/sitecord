PORT=4000

# Leave unset to use the built-in PGlite database (PostgreSQL in WebAssembly,
# stored in server/.data). Set it to use a PostgreSQL server instead, e.g. the
# one in docker-compose.yml:
# DATABASE_URL=postgresql://app:app@localhost:5432/construction

# Seeds demo data on first start and enables one-click demo sign-in.
# On by default in development. In production (NODE_ENV=production) it stays
# off unless this is explicitly "true", because it lets anyone in as the demo people.
DEMO_MODE=true

# Comma-separated origins allowed to make changes (CSRF protection). The
# server's own host is always allowed, so this is only needed for a separate
# web app origin such as the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Production: set NODE_ENV=production and keep the data folders on a disk that
# survives restarts. The built web app (client/dist) is served from the same port.
# NODE_ENV=production
# PGLITE_DIR=/var/data/pglite
# UPLOAD_DIR=/var/data/uploads
# CLIENT_DIR=/path/to/client/dist   # only if it isn't ../client/dist
